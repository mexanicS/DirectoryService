# Внешний порт nginx
HTTP_PORT=80

# Postgres внутри Docker
POSTGRES_DB=directory_service_db
POSTGRES_USER=directory_service
POSTGRES_PASSWORD=directory_service_local
POSTGRES_PORT=5432

# Приложения
BACKEND_PORT=8080
FRONTEND_PORT=3000
ASPNETCORE_ENVIRONMENT=Development

# Логи
SEQ_URL=http://seq:5341

# GitHub Packages: реальные значения заполняются в локальном .env
GITHUB_USERNAME=your-github-login
GITHUB_PACKAGES_TOKEN=

# Дополнительный мониторинг
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me