map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80 default_server;
    server_name _;

    absolute_redirect off;

    # Docker DNS: resolve service names again when containers are recreated.
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    set $backend_upstream http://backend:${BACKEND_PORT};
    set $frontend_upstream http://frontend:${FRONTEND_PORT};
    # Resolve optional services only when their routes are requested.
    set $grafana_upstream http://grafana:3000;
    set $prometheus_upstream http://prometheus:9090;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    location = /api {
        proxy_pass $backend_upstream$request_uri;
    }

    location ^~ /api/ {
        # Keep /api, query parameters and the original escaped URI.
        proxy_pass $backend_upstream$request_uri;
    }

    location = /grafana {
        return 308 /grafana/$is_args$args;
    }

    location ^~ /grafana/ {
        # Grafana serves its own subpath (GF_SERVER_SERVE_FROM_SUB_PATH=true).
        proxy_pass $grafana_upstream$request_uri;
    }

    location = /prometheus {
        return 308 /prometheus/$is_args$args;
    }

    location ^~ /prometheus/ {
        # Prometheus keeps internal routes at / for the Grafana datasource.
        rewrite ^/prometheus/(.*)$ /$1 break;
        proxy_pass $prometheus_upstream$uri$is_args$args;
    }

    location / {
        proxy_pass $frontend_upstream$request_uri;
    }
}
